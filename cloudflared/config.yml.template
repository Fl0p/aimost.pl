# Tunnel UUID. start.sh fills this in from the TunnelID field of credentials.json,
# so the rendered config always points at the tunnel whose keys it ships with.
tunnel: ${TUNNEL_ID}
credentials-file: /etc/cloudflared/credentials.json

ingress:
  - hostname: ${N8N_HOST}
    service: http://n8n:5678
  - service: http_status:404