# Copy to .env and fill in real values. .env is gitignored and must never be committed.
# In CI the whole file is stored as the ENV_FILE repository secret and written out by
# .github/workflows/ci.yml before ./start.sh runs.

# n8n
N8N_HOST=n8n.example.com
WEBHOOK_URL=https://n8n.example.com/
N8N_PORT=5678
# NOTE: basic auth was removed in n8n 1.x — these are likely ignored and access is
# controlled by n8n's built-in user management. Verify before relying on them.
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin@example.com
N8N_BASIC_AUTH_PASSWORD=changeme
# Losing this key makes all stored credentials unreadable. Back it up.
N8N_ENCRYPTION_KEY=please_set_a_secure_random_key

# PostgreSQL Database
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=changeme
