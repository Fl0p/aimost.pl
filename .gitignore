# OS files
.DS_Store
Thumbs.db

# Node.js (если где-то используется)
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log

# Docker
*.log
docker-compose.override.yml
docker-compose.override.yaml

# Environment variables
.env

# Cloudflare Tunnel credentials and generated configs
cloudflared/*.json
cloudflared/config.yml

# Temporary files
tmp/
*.tmp
*.swp

# VSCode settings
.vscode/

# ignore gitpmoji directory
gitpmoji

# Local MCP config. `.mcp.json` itself is tracked — it holds only ${VAR}
# placeholders and the values live in the shell environment (see AGENTS.md).
# This alternative location is not, since nothing stops a key landing in it.
.claude/mcp.json

# Local project secrets (n8n API key). Deliberately NOT .env: that file is
# stored as the ENV_FILE secret and deployed to the production host.
.secrets.env

# Exported workflows — kept locally, not versioned
flows/
